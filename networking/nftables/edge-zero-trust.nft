#!/usr/sbin/nft -f

# ============================================================
# DingasHost3
# Zero-Trust Edge Firewall
#
# Management : enp0s3  10.10.10.103/24
# WAN        : enp0s8  DHCP / VirtualBox NAT
# Corporate  : enp0s9  172.20.10.1/24
# DMZ        : enp0s10 172.20.20.1/24
# IoT        : enp0s16 172.20.30.1/24
# ============================================================

flush ruleset


table inet edge_filter {

    # --------------------------------------------------------
    # Trusted management endpoints
    # Windows host: 10.10.10.1
    # Ansible node : 10.10.10.100
    # --------------------------------------------------------

    set mgmt_admins {
        type ipv4_addr;
        elements = {
            10.10.10.1,
            10.10.10.100
        }
    }


    # --------------------------------------------------------
    # Internal security zones
    # --------------------------------------------------------

    set internal_nets {
        type ipv4_addr;
        flags interval;

        elements = {
            172.20.10.0/24,
            172.20.20.0/24,
            172.20.30.0/24
        }
    }


    # --------------------------------------------------------
    # Service groups
    # --------------------------------------------------------

    set web_ports {
        type inet_service;

        elements = {
            80,
            443
        }
    }


    set egress_tcp_ports {
        type inet_service;

        elements = {
            53,
            80,
            443
        }
    }


    set egress_udp_ports {
        type inet_service;

        elements = {
            53,
            123
        }
    }


    # --------------------------------------------------------
    # Dynamic per-source rate-limit tracking
    # --------------------------------------------------------

    set ssh_abusers {
        type ipv4_addr;
        flags dynamic, timeout;
        timeout 1m;
    }


    set api_abusers {
        type ipv4_addr;
        flags dynamic, timeout;
        timeout 5m;
    }


    # --------------------------------------------------------
    # Interface -> security-policy verdict map
    # --------------------------------------------------------

    map forward_dispatch {
        type ifname : verdict;

        elements = {
            "enp0s3"  : jump from_mgmt,
            "enp0s8"  : jump from_wan,
            "enp0s9"  : jump from_corp,
            "enp0s10" : jump from_dmz,
            "enp0s16" : jump from_iot
        }
    }


    # ========================================================
    # LOCAL FIREWALL INPUT
    # Traffic destined for DingasHost3 itself
    # ========================================================

    chain input {
        type filter hook input priority filter;
        policy drop;

        # Loopback is always trusted locally.
        iifname "lo" counter accept

        # Immediately reject broken conntrack states.
        ct state invalid counter drop

        # Return traffic for legitimate sessions.
        ct state { established, related } counter accept


        # ----------------------------------------------------
        # WAN DHCP
        # Required because edge-wan obtains its address through
        # VirtualBox DHCP.
        # ----------------------------------------------------

        iifname "enp0s8" \
            udp sport 67 \
            udp dport 68 \
            counter accept


        # ----------------------------------------------------
        # Essential ICMP
        # Necessary for routing diagnostics and path errors.
        # ----------------------------------------------------

        ip protocol icmp \
            icmp type {
                destination-unreachable,
                time-exceeded,
                parameter-problem
            } \
            counter accept


        # Internal ping is allowed but rate limited.
        iifname {
            "enp0s3",
            "enp0s9",
            "enp0s10",
            "enp0s16"
        } \
            ip protocol icmp \
            icmp type echo-request \
            limit rate 10/second \
            counter accept

        # ----------------------------------------------------
        # SSH administration / brute-force protection
        # ----------------------------------------------------

        # Already-blacklisted sources are dropped immediately.

        iifname "enp0s3" \
            ip saddr @ssh_abusers \
            tcp dport 22 \
            counter drop

        # Track NEW SSH connections independently per source.
        # Sources exceeding the threshold enter ssh_abusers.

        iifname "enp0s3" \
            ip saddr @mgmt_admins \
            tcp dport 22 \
            ct state new \
            add @ssh_meter { ip saddr limit rate over 12/minute } \
            add @ssh_abusers { ip saddr } \
            counter drop

        # Normal management SSH.

        iifname "enp0s3" \
            ip saddr @mgmt_admins \
            tcp dport 22 \
            ct state new \
            counter accept

        # ----------------------------------------------------
        # Future management API / brute-force protection
        # ----------------------------------------------------

        iifname "enp0s3" \
            ip saddr @api_abusers \
            tcp dport 8443 \
            counter drop

        iifname "enp0s3" \
            ip saddr @mgmt_admins \
            tcp dport 8443 \
            ct state new \
            add @api_meter { ip saddr limit rate over 60/minute } \
            add @api_abusers { ip saddr } \
            counter drop

        iifname "enp0s3" \
            ip saddr @mgmt_admins \
            tcp dport 8443 \
            ct state new \
            counter accept

        # ----------------------------------------------------
        # Rate-limited deny logging
        # ----------------------------------------------------

        limit rate 5/second \
            counter \
            log prefix "NFT_INPUT_DROP "

        counter drop
    }

    # --------------------------------------------------------
    # Dynamic rate tracking / temporary abuse lists
    # --------------------------------------------------------

    set ssh_meter {
        type ipv4_addr;
        flags dynamic;
        timeout 1m;
        size 65535;
    }

    set ssh_abusers {
        type ipv4_addr;
        flags dynamic;
        timeout 5m;
        size 65535;
    }

    set api_meter {
        type ipv4_addr;
        flags dynamic;
        timeout 1m;
        size 65535;
    }

    set api_abusers {
        type ipv4_addr;
        flags dynamic;
        timeout 5m;
        size 65535;
    }


    # ========================================================
    # ROUTED TRAFFIC
    # Zero-trust default: DROP
    # ========================================================

    chain forward {
        type filter hook forward priority filter;
        policy drop;

        ct state invalid counter drop

        ct state {
            established,
            related
        } counter accept


        # Dispatch traffic based on ingress security zone.
        iifname vmap @forward_dispatch


        # Anything not explicitly allowed reaches this point.
        limit rate 10/second \
            counter \
            log prefix "NFT_FORWARD_DROP "

        counter drop
    }


    # ========================================================
    # MANAGEMENT -> INTERNAL
    # ========================================================

    chain from_mgmt {

        # Only designated administrators may route into the
        # protected networks.

        ip saddr @mgmt_admins \
            ip daddr @internal_nets \
            tcp dport 22 \
            counter accept


        ip saddr @mgmt_admins \
            ip daddr @internal_nets \
            icmp type echo-request \
            limit rate 10/second \
            counter accept

        return
    }


    # ========================================================
    # CORPORATE ZONE
    # 172.20.10.0/24
    # ========================================================

    chain from_corp {

        # Anti-spoofing:
        # packets entering Corporate NIC must actually have
        # Corporate source addresses.

        ip saddr != 172.20.10.0/24 \
            counter drop


        # Corporate -> Internet:
        # DNS, HTTP, HTTPS

        oifname "enp0s8" \
            tcp dport @egress_tcp_ports \
            counter accept


        # Corporate -> Internet:
        # DNS and NTP

        oifname "enp0s8" \
            udp dport @egress_udp_ports \
            counter accept


        # Corporate -> DMZ web services only.

        oifname "enp0s10" \
            ip daddr 172.20.20.0/24 \
            tcp dport @web_ports \
            counter accept


        # No Corporate -> IoT lateral movement.
        # No Corporate -> Management routing unless explicitly
        # added later.

        return
    }


    # ========================================================
    # DMZ ZONE
    # 172.20.20.0/24
    # ========================================================

    chain from_dmz {

        ip saddr != 172.20.20.0/24 \
            counter drop


        # DMZ servers may obtain DNS/web updates.

        oifname "enp0s8" \
            tcp dport @egress_tcp_ports \
            counter accept


        oifname "enp0s8" \
            udp dport @egress_udp_ports \
            counter accept


        # DMZ cannot initiate connections toward Corporate,
        # IoT, or Management.

        return
    }


    # ========================================================
    # IoT ZONE
    # 172.20.30.0/24
    # ========================================================

    chain from_iot {

        ip saddr != 172.20.30.0/24 \
            counter drop


        # IoT has deliberately restricted Internet access.

        oifname "enp0s8" \
            tcp dport 443 \
            counter accept


        oifname "enp0s8" \
            udp dport {
                53,
                123
            } \
            counter accept


        # Example zero-trust exception:
        # IoT may reach a future TLS MQTT broker in the DMZ,
        # but nothing else inside the DMZ.

        oifname "enp0s10" \
            ip daddr 172.20.20.0/24 \
            tcp dport 8883 \
            counter accept


        # IoT -> Corporate denied.
        # IoT -> Management denied.

        return
    }


    # ========================================================
    # WAN ZONE
    # ========================================================

    chain from_wan {

        # No unsolicited WAN -> internal connectivity exists
        # yet.
        #
        # Later we can create an explicit HTTPS DNAT service
        # into a specific DMZ server.

        return
    }


    # ========================================================
    # LOCAL OUTPUT
    #
    # Keep host-originated traffic open during initial build.
    # We can harden router egress later.
    # ========================================================

    chain output {
        type filter hook output priority filter;
        policy accept;
    }
}


# ============================================================
# IPv4 NAT
# ============================================================

table ip edge_nat {

    chain postrouting {
        type nat hook postrouting priority srcnat;
        policy accept;


        # Only Corporate, DMZ and IoT networks are NATed.
        # Management is deliberately excluded.

        oifname "enp0s8" \
            ip saddr {
                172.20.10.0/24,
                172.20.20.0/24,
                172.20.30.0/24
            } \
            counter masquerade
    }
}

